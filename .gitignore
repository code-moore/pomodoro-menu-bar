# Build output — regenerated by ./build.sh
.build/
Pomodoro.app/

# Generated release artifacts — regenerated by ./release.sh
releases/

# Sparkle update signing key. MUST never be committed: anyone holding it can
# sign an update that every user would install. Back it up out of band.
sparkle_private_key.txt

# Machine-specific signing settings and credential exports
/.signing.local.sh
.env
.env.*
!.env.example
*.p8
*.p12
*.pfx
*.pem
*.key
*.mobileprovision
*.provisionprofile
*.keychain
*.keychain-db

# The public half is not secret — it ships inside every build — and is tracked
# so a fresh clone documents which key signs this app's updates.
!sparkle_public_key.txt

# Local scratch / diagnostic artefacts
.shots/
audit/
*.log
.DS_Store

# Mac App Store build, regenerated by ./build-appstore.sh
.build-appstore/
dist/

# Local Lean project notes
/.lean/notes/
/AGENTS.md
/CLAUDE.md
/Tools/LayoutProbe.swift
/Tools/ScreenProbe.swift
/Tools/TimeWidthProbe.swift
/Tools/WindowProbe.swift
