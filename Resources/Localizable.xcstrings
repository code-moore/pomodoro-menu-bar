    "Add a task below to build your day": {
      "comment": "Card text when nothing is planned. Wraps to at most 2 lines in 290pt.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge unten eine Aufgabe hinzu, um deinen Tag zu planen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade una tarea abajo para organizar tu día"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Magdagdag ng gawain sa ibaba para mabuo ang iyong araw"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez une tâche ci-dessous pour organiser votre journée"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi un’attività qui sotto per organizzare la giornata"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "下にタスクを追加して、1日の予定を立てましょう"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아래에 작업을 추가하여 하루를 계획하세요"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg hieronder een taak toe om je dag in te plannen"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione uma tarefa abaixo para montar seu dia"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lägg till en uppgift nedan för att planera din dag"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在下方添加任务，规划你的一天"
          }
        }
      }
    },
