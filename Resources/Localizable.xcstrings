{
  "sourceLanguage": "en",
  "strings": {
    "%lld meetings today": {
      "comment": "Panel header, next to a calendar icon. Number of timed meetings today.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld meeting today"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld meetings today"
                }
              }
            }
          }
        }
      }
    },
    "%lld/%lld done · %@ of work left": {
      "comment": "Panel header, top right, 12pt: tasks done of total, then work left, e.g. \"2/5 done · 1h 30m of work left\". Keep it short.",
      "extractionState": "manual"
    },
    "Add": {
      "comment": "Button that adds the task typed above it. Short.",
      "extractionState": "manual"
    },
    "Add a task below to build your day": {
      "comment": "Card text when nothing is planned. Wraps to at most 2 lines in 290pt.",
      "extractionState": "manual"
    },
    "All day": {
      "comment": "Time column of an all-day event. 78pt at 12pt: about 11 Latin characters at most.",
      "extractionState": "manual"
    },
    "All done. Add a task above to plan more.": {
      "comment": "Task list text when every task is finished.",
      "extractionState": "manual"
    },
    "Allow Pomodoro in Login Items to open it at login.": {
      "comment": "Settings note under Open at login when macOS needs approval. Login Items is macOS's name for System Settings > General > Login Items; use macOS's own name in this language.",
      "extractionState": "manual"
    },
    "Allow Pomodoro in System Settings > Privacy > Calendars": {
      "comment": "Panel header, 2 lines in 190pt. Use macOS's own names for System Settings, Privacy & Security and Calendars in this language.",
      "extractionState": "manual"
    },
    "Auto-start next block": {
      "comment": "Settings switch label, about 300pt.",
      "extractionState": "manual"
    },
    "Break": {
      "comment": "A short break's name in the day's plan and the menu bar.",
      "extractionState": "manual"
    },
    "Calendar access is restricted on this Mac": {
      "comment": "Panel header, 2 lines in 190pt.",
      "extractionState": "manual"
    },
    "Calendar event": {
      "comment": "Greyed-out right-click menu item on a calendar event row.",
      "extractionState": "manual"
    },
    "Calendar not connected, so meetings won't appear": {
      "comment": "Panel header, 2 lines in 190pt at 12pt.",
      "extractionState": "manual"
    },
    "Calendars": {
      "comment": "Settings section header above the list of calendars.",
      "extractionState": "manual"
    },
    "Cancel": {
      "comment": "Cancels the Clear all confirmation. Short.",
      "extractionState": "manual"
    },
    "Check for Updates…": {
      "comment": "Settings button. Use the standard macOS wording for this command in this language, ending in an ellipsis.",
      "extractionState": "manual"
    },
    "Choose Full Access for Pomodoro in System Settings": {
      "comment": "Panel header, 2 lines in 190pt. Full Access is macOS's name for the calendar permission level.",
      "extractionState": "manual"
    },
    "Clear all": {
      "comment": "Footer button that deletes every task. Short.",
      "extractionState": "manual"
    },
    "Clear done": {
      "comment": "Footer button that removes finished tasks from today. Short.",
      "extractionState": "manual"
    },
    "Connect": {
      "comment": "Compact button that asks macOS for calendar access. One short word if possible.",
      "extractionState": "manual"
    },
    "Connect your calendar from the panel to choose which ones count.": {
      "comment": "Settings, calendars section, when calendar access isn't granted yet.",
      "extractionState": "manual"
    },
    "Delete": {
      "comment": "Confirms Clear all. Destructive. Short.",
      "extractionState": "manual"
    },
    "Delete all %lld tasks?": {
      "comment": "Inline confirmation in the panel footer before deleting every task. Keep it short.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Delete %lld task?"
                }
