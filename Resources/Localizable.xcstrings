      "comment": "Settings label next to a number box for the finish hour, 24-hour clock.",
      "extractionState": "manual"
    },
    "Hours": {
      "comment": "Placeholder inside an 84pt box for a task's hours. Short.",
      "extractionState": "manual"
    },
    "Hours as a number, like 1 or 1.5": {
      "comment": "Tooltip when the hours box isn't a number. Both 1.5 and 1,5 are accepted, so use this language's decimal separator in the example.",
      "extractionState": "manual"
    },
    "in %@": {
      "comment": "Menu bar, after a meeting's name: time until it starts, e.g. \"in 12m\". Keep it very short.",
      "extractionState": "manual"
    },
    "Least urgent": {
      "comment": "Task priority, shown as a tooltip on its coloured dot.",
