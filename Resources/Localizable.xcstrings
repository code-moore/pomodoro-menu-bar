              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Delete all %lld tasks?"
                }
              }
            }
          }
        }
      }
    },
    "Delete task": {
      "comment": "Right-click menu item on a task row.",
      "extractionState": "manual"
    },
    "Delete this task": {
      "comment": "Tooltip on the trash button.",
      "extractionState": "manual"
    },
    "Done": {
      "comment": "Small section header above finished tasks, 11pt. Means finished, not the OK button.",
      "extractionState": "manual"
    },
    "Edit this task": {
      "comment": "Tooltip on the pencil button.",
