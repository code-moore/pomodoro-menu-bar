    "All done. Add a task above to plan more.": {
      "comment": "Task list text when every task is finished.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles erledigt. Füge oben eine Aufgabe hinzu, um mehr zu planen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo completado. Añade una tarea arriba para planificar más."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Tapos na lahat. Magdagdag ng gawain sa itaas para magplano pa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout est terminé. Ajoutez une tâche ci-dessus pour en prévoir d’autres."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutto fatto. Aggiungi un’attività qui sopra per pianificarne altre."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべて完了しました。さらに予定を立てるには、上にタスクを追加してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모두 완료했습니다. 더 계획하려면 위에 작업을 추가하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles klaar. Voeg hierboven een taak toe om meer te plannen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tudo concluído. Adicione uma tarefa acima para planejar mais."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Allt klart. Lägg till en uppgift ovan för att planera mer."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "全部完成。在上方添加任务以继续规划。"
          }
        }
      }
    },
    "Allow Pomodoro in Login Items to open it at login.": {
      "comment": "Settings note under Open at login when macOS needs approval. Login Items is macOS's name for System Settings > General > Login Items; use macOS's own name in this language.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaube Pomodoro unter „Anmeldeobjekte“, damit es bei der Anmeldung geöffnet wird."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite Pomodoro en “Ítems de inicio” para que se abra al iniciar sesión."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Payagan ang Pomodoro sa “Login Items” para magbukas ito pag-log in mo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez Pomodoro dans « Ouverture et extensions » pour qu’il s’ouvre avec la session."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consenti Pomodoro in “Elementi login” per aprirlo al login."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ログイン時に開くには、「ログイン項目」でPomodoroを許可してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로그인 시 열리도록 ‘로그인 항목’에서 Pomodoro를 허용하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sta Pomodoro toe in ‘Inlogonderdelen’ om het bij inloggen te openen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permita o Pomodoro em “Itens de Início” para abri-lo no início da sessão."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tillåt Pomodoro i ”Startobjekt” för att öppna det vid inloggning."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在“登录项”中允许 Pomodoro，以便在登录时打开它。"
          }
        }
      }
    },
    "Allow Pomodoro in System Settings > Privacy > Calendars": {
      "comment": "Panel header, 2 lines in 190pt. Use macOS's own names for System Settings, Privacy & Security and Calendars in this language.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Datenschutz & Sicherheit > Kalender: Pomodoro erlauben"
