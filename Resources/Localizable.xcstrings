    "Your saved tasks couldn't be read. A copy was kept so they can be recovered: see quietpomodoro.com/mac/support.": {
      "comment": "Rare warning at the top of the panel. Keep the web address, with this language's folder added, e.g. quietpomodoro.com/de/mac/support for German.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine gespeicherten Aufgaben konnten nicht gelesen werden. Eine Kopie wurde aufbewahrt, damit sie wiederhergestellt werden können: siehe quietpomodoro.com/de/mac/support."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se han podido leer tus tareas guardadas. Se ha guardado una copia para poder recuperarlas: consulta quietpomodoro.com/es/mac/support."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi mabasa ang iyong mga naka-save na gawain. May itinabing kopya para maibalik ang mga ito: tingnan ang quietpomodoro.com/fil/mac/support."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de lire vos tâches enregistrées. Une copie a été conservée pour pouvoir les récupérer : consultez quietpomodoro.com/fr/mac/support."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile leggere le attività salvate. È stata conservata una copia per poterle recuperare: consulta quietpomodoro.com/it/mac/support."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存したタスクを読み込めませんでした。復元できるようにコピーを残してあります。詳しくは quietpomodoro.com/ja/mac/support をご覧ください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장된 작업을 읽을 수 없습니다. 복구할 수 있도록 사본을 보관해 두었습니다. quietpomodoro.com/ko/mac/support를 참조하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je bewaarde taken konden niet worden gelezen. Er is een kopie bewaard zodat ze kunnen worden hersteld: zie quietpomodoro.com/nl/mac/support."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível ler suas tarefas salvas. Uma cópia foi mantida para que possam ser recuperadas: consulte quietpomodoro.com/pt-br/mac/support."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dina sparade uppgifter kunde inte läsas. En kopia har sparats så att de kan återställas: se quietpomodoro.com/sv/mac/support."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取你存储的任务。已保留一份副本以便恢复：请参阅 quietpomodoro.com/zh-hans/mac/support。"
          }
        }
      }
    },
